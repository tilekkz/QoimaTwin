{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qoima:proposal:cargo-archetype:v3:0.1.0",
  "title": "CargoArchetype v3 isolated proposal record",
  "$comment": "Structural schema plus tools/visual/v3/validate_cargo_contract.py for finite numbers, derived identities, proper signed rotations and exact source/layout binding. No solver or operational admission.",
  "$defs": {
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "xyz_m": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/positive_number"
      }
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
    },
    "hash64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_type",
    "status",
    "source_kind",
    "operational_admission",
    "archetype_id",
    "label",
    "layout_binding",
    "reference_binding",
    "unit",
    "handling_unit",
    "orientation",
    "fragile",
    "stacking",
    "handling",
    "compatibility",
    "source_of_assumptions"
  ],
  "properties": {
    "schema_id": {
      "const": "qoima.cargo-archetype.v3-proposal"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "CargoArchetype"
    },
    "status": {
      "const": "proposal"
    },
    "source_kind": {
      "enum": [
        "synthetic_design",
        "measured_input"
      ]
    },
    "operational_admission": {
      "const": false
    },
    "archetype_id": {
      "enum": [
        "SMALL_CARTON",
        "STANDARD_CARTON",
        "HEAVY_BOX",
        "PALLET_LOAD",
        "IBC",
        "LONG_BUNDLE",
        "DRUM",
        "FRAGILE_CRATE"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "layout_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "layout_version",
        "layout_content_hash",
        "public_runtime_sha256"
      ],
      "properties": {
        "manifest_path": {
          "const": "docs/v3/contract-proposals/layout-manifest-v3.json"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/hash64"
        },
        "layout_version": {
          "const": "qoima-144x72-v3-proposal"
        },
        "layout_content_hash": {
          "$ref": "#/$defs/hash64"
        },
        "public_runtime_sha256": {
          "$ref": "#/$defs/hash64"
        }
      }
    },
    "reference_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "archetype_id",
        "dimensions_role"
      ],
      "properties": {
        "path": {
          "const": "assets/references/v3/r03-dimension-targets.json"
        },
        "sha256": {
          "$ref": "#/$defs/hash64"
        },
        "archetype_id": {
          "enum": [
            "SMALL_CARTON",
            "STANDARD_CARTON",
            "HEAVY_BOX",
            "PALLET_LOAD",
            "IBC",
            "LONG_BUNDLE",
            "DRUM",
            "FRAGILE_CRATE"
          ]
        },
        "dimensions_role": {
          "const": "handling_unit_outer_target"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions_xyz_m",
        "bounding_volume_m3",
        "contents_mass_kg",
        "packaging_tare_mass_kg",
        "gross_mass_kg",
        "mass_scope"
      ],
      "properties": {
        "dimensions_xyz_m": {
          "$ref": "#/$defs/xyz_m"
        },
        "bounding_volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contents_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "packaging_tare_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gross_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mass_scope": {
          "const": "contents_plus_primary_unit_packaging"
        }
      },
      "description": "One packaged physical unit; these are not the outer R03 handling-unit target dimensions."
    },
    "handling_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions_xyz_m",
        "bounding_volume_m3",
        "units_per_handling_unit",
        "packaging_type",
        "packaging_tare_mass_kg",
        "contents_gross_mass_kg",
        "gross_mass_kg",
        "mass_scope"
      ],
      "properties": {
        "dimensions_xyz_m": {
          "$ref": "#/$defs/xyz_m"
        },
        "bounding_volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units_per_handling_unit": {
          "type": "integer",
          "minimum": 1
        },
        "packaging_type": {
          "enum": [
            "carton",
            "palletized",
            "caged_tank",
            "bundled",
            "drum_on_support",
            "protective_crate"
          ]
        },
        "packaging_tare_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contents_gross_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gross_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mass_scope": {
          "const": "packaged_units_plus_HU_packaging_and_integral_support_excludes_vehicle_attachments"
        }
      },
      "description": "Outer packed HU including integral packaging/support; vehicle and detachable attachment masses are counted separately by C08."
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upright_only",
        "permitted_orientations",
        "slot_orientation_mappings"
      ],
      "properties": {
        "upright_only": {
          "type": "boolean"
        },
        "permitted_orientations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": false,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "orientation_id",
              "local_axes_in_destination"
            ],
            "properties": {
              "orientation_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
              },
              "local_axes_in_destination": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "+X",
                    "-X",
                    "+Y",
                    "-Y",
                    "+Z",
                    "-Z"
                  ]
                }
              }
            }
          }
        },
        "slot_orientation_mappings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": false,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot_orientation_id",
              "cargo_orientation_id"
            ],
            "properties": {
              "slot_orientation_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
              },
              "cargo_orientation_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
              }
            }
          }
        }
      },
      "description": "Applies to the complete handling unit relative to the destination module/carrier frame. Unit packing poses and physical packing fit require a later packing rule."
    },
    "fragile": {
      "type": "boolean"
    },
    "stacking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stackable",
        "max_stack"
      ],
      "properties": {
        "stackable": {
          "type": "boolean"
        },
        "max_stack": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "modes"
      ],
      "properties": {
        "candidate_only": {
          "const": true
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": false,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transport_tag",
              "required_handler_tag",
              "required_equipment_tags"
            ],
            "properties": {
              "transport_tag": {
                "enum": [
                  "manual_hand_carry",
                  "manual_cart",
                  "light_conveyor",
                  "forklift_assisted"
                ]
              },
              "required_handler_tag": {
                "enum": [
                  "manual_operator",
                  "forklift_operator",
                  "handoff_operator",
                  "specialist_handler"
                ]
              },
              "required_equipment_tags": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "manual_cart",
                    "light_conveyor",
                    "forklift",
                    "approved_load_support"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_type_tags",
        "property_tags",
        "candidate_only"
      ],
      "properties": {
        "storage_type_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SMALL",
              "STANDARD",
              "HEAVY",
              "LONG",
              "FLEX"
            ]
          }
        },
        "property_tags": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
          }
        },
        "candidate_only": {
          "const": true
        }
      }
    },
    "source_of_assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "kind",
          "fields",
          "statement"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9:_-]*$"
          },
          "kind": {
            "enum": [
              "synthetic_design",
              "measured_input"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
