# Optional backend-only Mercury configuration. Leave blank to disable explanations.
# Supply through environment/secret manager or an ignored local backend/.env; never commit it.
# File loading requires API server configuration to explicitly call:
# MercurySettings.from_env(env_file=backend_dir / ".env")
# backend_dir must be server-owned, never an HTTP path. from_env() alone loads no file.
# Process environment overrides these four settings, even an empty key. See docs/mercury.md.
INCEPTION_API_KEY=
# Current official quickstart default; availability for your account is unverified.
MERCURY_MODEL=mercury-3
# Greater than 0, at most 30 seconds per HTTP operation.
MERCURY_TIMEOUT_S=10
# Integer 1..4096; no automatic retry on provider failure.
MERCURY_MAX_COMPLETION_TOKENS=1024
