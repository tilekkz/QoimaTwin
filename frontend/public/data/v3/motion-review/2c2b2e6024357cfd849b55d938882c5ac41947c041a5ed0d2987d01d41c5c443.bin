  },
  "positive_cases": [
    "real_Float32_static_basis_RED_is_nonvacuous",
    "caller_redirects_same_HU_map_entry_without_new_inventory_identity",
    "activation_preserves_all4_actual_native_world_matrices_and_has_one_visible_logical_HU",
    "explicit_main_body_frame_and_detached_public_captures",
    "gateway_all90degree_turn_headings_and_end_native_grip_pass_on_Float64_object_times_identity_instance",
    "actual_after_write_failure_restores_all4_previous_owned_world_matrices",
    "reset_identity_returns_captured_native_state",
    "dispose_restores_original4_Float32_slices_and_releases_only4_owned_instance_allocations",
    "failed_activation_releases_leases_and_can_reactivate",
    "cleanup_attempts_all4_allocations_and_releases_leases_even_when_observer_throws"
  ],
  "negative_cases": [
    {
      "case": "wrong_logical_HU",
      "reason": "INVALID_SOURCE_BINDING"
    },
    {
      "case": "duplicate_source_part",
      "reason": "DUPLICATE_SOURCE_PART"
    },
    {
      "case": "out_of_range_source_index",
      "reason": "INVALID_SOURCE_BINDING"
    },
    {
      "case": "duplicate_active_owner",
      "reason": "SOURCE_ALREADY_OWNED"
    },
    {
      "case": "scale_delta",
      "reason": "NON_RIGID_DELTA"
    },
    {
      "case": "nonfinite_delta",
      "reason": "INVALID_MATRIX"
    },
    {
      "case": "perspective_delta",
      "reason": "NON_AFFINE_MATRIX"
    },
    {
      "case": "matrix_accessor_not_invoked",
      "reason": "INVALID_MATRIX"
    },
    {
      "case": "post_write_atomic_matrix_rollback",
      "reason": "DYNAMIC_APPLY_FAILED"
    },
    {
      "case": "foreign_active_flag_change_repaired",
      "reason": "ACTIVE_BINDING_CHANGED"
    },
    {
      "case": "foreign_active_source_metadata_repaired",
      "reason": "ACTIVE_BINDING_CHANGED"
    },
    {
      "case": "apply_after_dispose",
      "reason": "DYNAMIC_BINDING_DISPOSED"
    },
    {
      "case": "activation_after_partial_attach_rolls_back",
      "reason": "DYNAMIC_ACTIVATION_FAILED"
    },
    {
      "case": "foreign_source_buffer_mutation_refused_without_rewinding_it",
      "reason": "SOURCE_BINDING_CHANGED"
    },
    {
      "case": "unowned_ancestor_change_refused_without_global_lease",
      "reason": "SOURCE_BINDING_CHANGED"
    },
    {
      "case": "one_disposal_observer_cannot_leak_other_owned_parts",
      "reason": "DYNAMIC_DISPOSAL_FAILED"
    }
  ],
  "limitations": [
    "Active native UUID/index changes are intentional render-binding changes; source UUID/index and the logical HU remain captured/restorable. No new inventory HU is created.",
    "Caller owns active Map redirection, scene scheduling and higher-level resource admission; this helper does not claim a Scene-wide lease.",
    "Foreign unowned state changes are refused and not silently rewound. Disposal restores owned original source slices; replacing the source buffer/attribute identity is explicitly unsupported.",
    "CPU object/world matrices are Float64 with identity Float32 instance matrices; no GPU pixel or micrometre accuracy certificate."
  ]
}
