import {validateWorkerRegistry} from './workerRegistry';
import {validateWorkerProfiles} from './workerProfiles';
import type {WarehouseBundle,WarehouseFixture,WarehouseGraph,WarehouseLayout,V3Record,V3Bounds,XYZ} from './warehouseTypes';

export type WarehouseAdapterReason='ACTUAL_V3_UNSUPPORTED'|'INVALID_JSON'|'SOURCE_SCOPE_MISMATCH'|'LAYOUT_MISMATCH'|'TABLE_INVALID'|'INDEX_INVALID'|'IDENTITY_MISMATCH'|'CARGO_MISMATCH'|'REQUEST_INVALID'|'BUNDLE_HASH_MISMATCH'|'FIXTURE_NOT_REGISTERED'|'PROFILE_MISMATCH';
export class WarehouseAdapterError extends Error{constructor(readonly reason:WarehouseAdapterReason,message:string){super(message);this.name='WarehouseAdapterError';}}
const fail=(reason:WarehouseAdapterReason,message:string):never=>{throw new WarehouseAdapterError(reason,message);};
const requireValue=(ok:unknown,reason:WarehouseAdapterReason,message:string):void=>{if(!ok)fail(reason,message);};
const record=(v:unknown):v is V3Record=>typeof v==='object'&&v!==null&&!Array.isArray(v);
const finite=(v:unknown):v is number=>typeof v==='number'&&Number.isFinite(v);
const vec=(v:unknown):v is XYZ=>Array.isArray(v)&&v.length===3&&v.every(finite);
const text=(v:unknown):v is string=>typeof v==='string'&&v.length>0;
const array=(v:unknown):unknown[]=>Array.isArray(v)?v:fail('TABLE_INVALID','Отсутствует таблица V3.');
const obj=(v:unknown):V3Record=>record(v)?v:fail('TABLE_INVALID','Некорректный объект V3.');
const index=(v:unknown,size:number):number=>Number.isInteger(v)&&(v as number)>=0&&(v as number)<size?v as number:fail('INDEX_INVALID','Индекс относится к другому пакету V3.');
const bounds=(v:unknown):V3Bounds=>{const b=obj(v);requireValue(vec(b.min)&&vec(b.max)&&(b.min as XYZ).every((n,i)=>n<=(b.max as XYZ)[i]),'TABLE_INVALID','Некорректные габариты V3.');return b as V3Bounds;};
function freeze<T>(v:T):T{if(v&&typeof v==='object'){for(const x of Object.values(v))freeze(x);Object.freeze(v);}return v;}
function unique(rows:V3Record[],key:string){requireValue(rows.every(r=>text(r[key]))&&new Set(rows.map(r=>r[key])).size===rows.length,'IDENTITY_MISMATCH','ID V3 отсутствует или повторяется.');}
/** Numeric indices are local to this exact layout_content_hash. */
export function decodeV3Table(value:unknown):V3Record[]{
 const t=obj(value),columns=array(t.columns),rows=array(t.rows);requireValue(columns.length>0&&columns.every(c=>typeof c==='string'&&/^[a-z][a-z0-9_]*$/.test(c))&&new Set(columns).size===columns.length,'TABLE_INVALID','Колонки таблицы V3 некорректны.');
 return rows.map(row=>{requireValue(Array.isArray(row)&&row.length===columns.length,'TABLE_INVALID','Строка таблицы V3 имеет другую длину.');return Object.fromEntries(columns.map((c,i)=>[c,(row as unknown[])[i]]));});
}
function decodeGraph(value:unknown,vehicle:boolean):WarehouseGraph{
 const source=obj(value),nodes=decodeV3Table(source.nodes),arcs=decodeV3Table(source.arcs);unique(nodes,'node_id');unique(arcs,'arc_id');
 return {nodes:nodes.map(n=>{requireValue(vec(n.world_pos)&&(!vehicle||finite(n.yaw_rad)),'TABLE_INVALID','Некорректная поза узла V3.');return{node_id:n.node_id as string,world_pos:n.world_pos as XYZ,yaw_rad:vehicle?n.yaw_rad as number:null,attributes:obj(n.attributes)};}),arcs:arcs.map(a=>{requireValue(finite(a.length_m)&&a.length_m>0,'TABLE_INVALID','Некорректная длина ребра V3.');if(vehicle){const g=obj(a.geometry);requireValue(['line','rear_steer_arc'].includes(g.kind as string)&&finite(g.start_yaw_rad)&&finite(g.end_yaw_rad),'TABLE_INVALID','Нет аналитической геометрии транспорта V3.');}else requireValue(Array.isArray(a.allowed_modes)&&a.allowed_modes.length>0,'TABLE_INVALID','Не задан режим ребра V3.');return {arc_id:a.arc_id as string,from_node_index:index(a.from_node_index,nodes.length),to_node_index:index(a.to_node_index,nodes.length),length_m:a.length_m as number,fields:a};})};
}
export function decodeWarehouseLayout(value:unknown):WarehouseLayout{
 const root=obj(value);requireValue(root.schema_id==='qoima.layout-runtime.v3-proposal'&&root.data_kind==='geometry_proposal'&&root.layout_version==='qoima-144x72-v3-proposal'&&root.operational_admission===false&&root.backend_integration_complete===false,'LAYOUT_MISMATCH','Ожидается согласованный геометрический пакет V3.');
 const data=obj(root.data),envelope=obj(data.envelope),b=bounds(envelope.bounds);requireValue(JSON.stringify(b.min)==='[0,0,0]'&&JSON.stringify(b.max)==='[144,8,72]'&&envelope.entity_dimension_scale_factor===1,'LAYOUT_MISMATCH','Масштаб или пространство склада V3 не совпадает.');
 const graphs=obj(data.graphs),walk=decodeGraph(graphs.walk,false),vehicle=decodeGraph(graphs.vehicle,true),storage=obj(data.storage),modules=decodeV3Table(storage.modules),slots=decodeV3Table(storage.slots),zones=array(data.zones);unique(modules,'module_id');unique(slots,'slot_id');requireValue(modules.length===132&&slots.length===776&&walk.nodes.length===1633&&vehicle.nodes.length===620,'IDENTITY_MISMATCH','Состав геометрического пакета V3 изменён.');
 const result:WarehouseLayout={layout_content_hash:root.layout_content_hash as string,data,walk,vehicle,modules:modules.map(m=>{requireValue(vec(m.world_pos)&&finite(m.yaw_rad)&&['SMALL','STANDARD','HEAVY','LONG','FLEX'].includes(m.family as string),'TABLE_INVALID','Некорректный модуль хранения V3.');return{module_id:m.module_id as string,family:m.family as string,world_pos:m.world_pos as XYZ,yaw_rad:m.yaw_rad as number,zone_index:index(m.zone_index,zones.length),outer_bounds_world:bounds(m.outer_bounds_world)};}),slots:slots.map(s=>{const ref=array(s.service_ref);requireValue(ref.length===2&&['walk','vehicle'].includes(ref[0] as string)&&vec(s.usable_dimensions_xyz_m)&&vec(s.bin_anchor)&&typeof s.reserve_only==='boolean'&&typeof s.retrieval_blocked==='boolean'&&finite(s.max_payload_kg)&&s.max_payload_kg>0&&Number.isInteger(s.max_handling_units),'TABLE_INVALID','Некорректный адрес V3.');return{slot_id:s.slot_id as string,module_index:index(s.module_index,modules.length),usable_dimensions_xyz_m:s.usable_dimensions_xyz_m as XYZ,usable_bounds_world:bounds(s.usable_bounds_world),bin_anchor:s.bin_anchor as XYZ,reserve_only:s.reserve_only as boolean,retrieval_blocked:s.retrieval_blocked as boolean,worker_node_index:index(s.worker_node_index,walk.nodes.length),cart_stop_node_index:index(s.cart_stop_node_index,walk.nodes.length),vehicle_node_index:s.vehicle_node_index===null?null:index(s.vehicle_node_index,vehicle.nodes.length),service_ref:[ref[0] as 'walk'|'vehicle',index(ref[1],ref[0]==='walk'?walk.nodes.length:vehicle.nodes.length)],max_payload_kg:s.max_payload_kg as number,max_handling_units:s.max_handling_units as number};})};
 return result;
}
export const WAREHOUSE_BASE_FILES={fixture:'/data/v3/warehouse-fixture-v3.json',layout:'/data/adaptive-v3/layout-manifest.json',registry:'/data/v3/worker-registry-v3.json',profiles:'/data/v3/worker-profiles-v3.json'} as const;
// Explicit registered visual input; additional W scenarios require their own admitted registration.
const acceptedBase={id:'v3:fixture:warehouse-base:001',sha256:'81d0caad4898a68a41f9c647141e7290df480900599e82b81739809cab0f9579'};
export type WarehouseTexts={fixture:string;layout:string;registry:string;profiles:string};
const sha256=async(text:string)=>[...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(text)))].map(n=>n.toString(16).padStart(2,'0')).join('');
function parse(text:string):V3Record{try{const data:unknown=JSON.parse(text);if(record(data))return data;}catch{/* Typed rejection below. */}return fail('INVALID_JSON','Файл V3 не содержит корректный JSON-объект.');}
/** Read-only compatible snapshot. Never activates a backend or interprets V2 runs. */
export async function adaptWarehouseV3(texts:WarehouseTexts):Promise<WarehouseBundle>{
 const value=parse(texts.fixture);if(value.source_kind==='actual_engine_run'||value.engine_operation===true)fail('ACTUAL_V3_UNSUPPORTED','Actual engine run V3 пока не поддерживается.');
 requireValue(value.schema_id==='qoima.warehouse-visual-fixture.v3'&&value.namespace==='v3'&&value.layout_version==='qoima-144x72-v3'&&value.source_kind==='visual_fixture'&&value.engine_operation===false&&value.operational_admission===false&&value.metrics_scope==='none'&&value.actual_v3_run_supported===false&&value.execution_state==='not_scheduled'&&Array.isArray(value.actions)&&value.actions.length===0&&Array.isArray(value.completion_events)&&value.completion_events.length===0,'SOURCE_SCOPE_MISMATCH','Ожидается подготовленный visual fixture V3.');
 requireValue(value.fixture_id===acceptedBase.id,'FIXTURE_NOT_REGISTERED','Этот visual fixture V3 ещё не принят.');
 const [fixtureHash,layoutHash,registryHash,profilesHash]=await Promise.all([texts.fixture,texts.layout,texts.registry,texts.profiles].map(sha256));
 requireValue(fixtureHash===acceptedBase.sha256,'BUNDLE_HASH_MISMATCH','Данные fixture изменились после проверки.');
 const fixture=value as unknown as WarehouseFixture,layoutValue=parse(texts.layout);
 requireValue(fixture.layout_ref.path==='frontend/public/data/adaptive-v3/layout-manifest.json'&&fixture.layout_ref.url===WAREHOUSE_BASE_FILES.layout&&fixture.layout_ref.sha256===layoutHash&&fixture.layout_ref.layout_content_hash===layoutValue.layout_content_hash,'LAYOUT_MISMATCH','Fixture относится к другой геометрии V3.');
 requireValue(fixture.registry_ref.path==='frontend/public/data/v3/worker-registry-v3.json'&&fixture.registry_ref.sha256===registryHash&&fixture.profiles_ref.path==='frontend/public/data/v3/worker-profiles-v3.json'&&fixture.profiles_ref.sha256===profilesHash,'BUNDLE_HASH_MISMATCH','Профили или реестр относятся к другому пакету V3.');
 let registry,profiles;try{registry=validateWorkerRegistry(JSON.parse(texts.registry));profiles=validateWorkerProfiles(JSON.parse(texts.profiles),registry,registryHash);}catch{fail('PROFILE_MISMATCH','Не удалось подтвердить 24 исходных профиля V3.');}
 const layout=decodeWarehouseLayout(layoutValue),slots=new Map(layout.slots.map(s=>[s.slot_id,s])),archetypes=new Map(fixture.inputs.archetypes.map(a=>[a.archetype_id,obj(a.handling_unit)])),occupied=new Set<string>();
 requireValue(fixture.inputs.initial_stock.length===530&&new Set(fixture.inputs.initial_stock.map(r=>r.handling_unit_id)).size===530&&fixture.inputs.workers.length===24&&fixture.inputs.vehicles.length===2&&fixture.inputs.ports.length===6,'IDENTITY_MISMATCH','Состав fixture V3 не совпадает.');
 for(const item of fixture.inputs.initial_stock){const slot=slots.get(item.location.slot_id),hu=archetypes.get(item.archetype_id);requireValue(slot&&hu&&!slot.reserve_only&&!slot.retrieval_blocked&&!occupied.has(slot.slot_id)&&layout.modules[slot.module_index].module_id===item.location.module_id,'CARGO_MISMATCH','Груз ссылается на недоступный адрес V3.');requireValue(item.model_scale_factor===1&&item.orientation_id==='upright_xyz'&&vec(item.location.placement.centre_local_xyz_m)&&item.gross_mass_kg===hu!.gross_mass_kg&&item.quantity_units===hu!.units_per_handling_unit&&JSON.stringify(item.dimensions_xyz_m)===JSON.stringify(hu!.dimensions_xyz_m),'CARGO_MISMATCH','Размеры, масса или ориентация груза V3 изменены.');occupied.add(slot!.slot_id);}
 requireValue(fixture.inputs.requests.length===16&&fixture.clock.duration_s===1800&&fixture.inputs.requests.every(r=>r.source_kind==='visual_fixture'&&r.engine_operation===false&&finite(r.requested_at_s)&&finite(r.deadline_at_s)&&r.requested_at_s>=0&&r.requested_at_s<r.deadline_at_s&&r.deadline_at_s<=1800),'REQUEST_INVALID','Временные данные запросов V3 некорректны.');
 return freeze({source_kind:'visual_fixture',engine_operation:false,fixture,layout,registry:registry!,profiles:profiles!});
}
