{
  "name": "qoima-twin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "verify:assets": "node tools/verify-assets.mjs",
    "test:smoke": "playwright test",
    "test:native-pair:adversarial": "node tools/check-native-pair-adversarial-v3.mjs",
    "test:twin-shift:adversarial": "node tools/check-twin-shift-adversarial-v3.mjs",
    "test:scenario:adversarial": "node tools/check-scenario-adversarial-v3.mjs",
    "test:pages:adversarial": "node tools/check-page-adversarial-browser-v3.mjs"
  },
  "dependencies": {
    "three": "0.169.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-vue": "6.0.10",
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
