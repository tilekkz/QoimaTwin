{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "layout_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "historical_partial_baskets",
            "synthetic_fixture"
          ]
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "source_notes": {
          "type": "string",
          "minLength": 1
        },
        "orders_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "generator_version",
        "seed",
        "source_notes",
        "orders_sha256",
        "receipts_sha256"
      ],
      "additionalProperties": false
    },
    "horizon_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "arrival_s": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "sku_id",
                "quantity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "order_id",
          "arrival_s",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "arrival_s": {
            "type": "number",
            "minimum": 0
          },
          "sku_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "receipt_id",
          "arrival_s",
          "sku_id",
          "quantity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "layout_version",
    "provenance",
    "horizon_s",
    "orders",
    "receipts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
