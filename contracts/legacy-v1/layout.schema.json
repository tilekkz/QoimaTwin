{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qoyma.local/schema/layout-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "layout_version": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "m"
        },
        "time": {
          "const": "s"
        },
        "up_axis": {
          "const": "Y"
        },
        "handedness": {
          "const": "right"
        }
      },
      "required": [
        "length",
        "time",
        "up_axis",
        "handedness"
      ],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "node_id",
          "pos"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1
          },
          "b": {
            "type": "string",
            "minLength": 1
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "a",
          "b",
          "length_m"
        ],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "pick_node_id": {
            "type": "string",
            "minLength": 1
          },
          "bin_anchor": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rack_center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rack_size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "slot_id",
          "pick_node_id",
          "bin_anchor",
          "rack_center",
          "rack_size"
        ],
        "additionalProperties": false
      }
    },
    "pack_node_id": {
      "type": "string",
      "minLength": 1
    },
    "buffer_node_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_mesh_center": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "buffer_bin_anchor": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "schema_version",
    "layout_version",
    "units",
    "bounds",
    "nodes",
    "edges",
    "slots",
    "pack_node_id",
    "buffer_node_id",
    "pack_mesh_center",
    "buffer_bin_anchor"
  ],
  "additionalProperties": false
}
