{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qoyma.local/schema/run-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "layout_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "required": [
        "walk_speed_mps",
        "pick_base_s",
        "pick_per_unit_s",
        "dropoff_s",
        "pack_base_s",
        "pack_per_line_s",
        "pack_per_unit_s",
        "relocation_handle_s",
        "relocation_worker_count",
        "picker_count",
        "packer_count",
        "horizon_s",
        "routing_policy",
        "queue_policy",
        "congestion"
      ],
      "additionalProperties": false,
      "properties": {
        "walk_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pick_base_s": {
          "type": "integer",
          "minimum": 0
        },
        "pick_per_unit_s": {
          "type": "number",
          "minimum": 0
        },
        "dropoff_s": {
          "type": "integer",
          "minimum": 0
        },
        "pack_base_s": {
          "type": "integer",
          "minimum": 0
        },
        "pack_per_line_s": {
          "type": "integer",
          "minimum": 0
        },
        "pack_per_unit_s": {
          "type": "number",
          "minimum": 0
        },
        "relocation_handle_s": {
          "type": "integer",
          "minimum": 0
        },
        "relocation_worker_count": {
          "type": "integer",
          "minimum": 1
        },
        "picker_count": {
          "type": "integer",
          "minimum": 1
        },
        "packer_count": {
          "type": "integer",
          "minimum": 1
        },
        "horizon_s": {
          "type": "integer",
          "minimum": 0
        },
        "routing_policy": {
          "type": "string",
          "minLength": 1
        },
        "queue_policy": {
          "type": "string",
          "minLength": 1
        },
        "congestion": {
          "type": "boolean"
        }
      }
    },
    "initial_assignment": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 20,
      "maxProperties": 20
    },
    "scenario": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "minLength": 1
              },
              "arrival_s": {
                "type": "number",
                "minimum": 0
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "sku_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "sku_id",
                    "quantity"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "order_id",
              "arrival_s",
              "lines"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scenario_id",
        "provenance",
        "orders"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "WALK",
              "PICK",
              "DROPOFF",
              "PACK",
              "IDLE"
            ]
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "sku_id": {
            "type": "string",
            "minLength": 1
          },
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "at_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "node_id",
                "pos",
                "at_s"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "action_id",
          "actor_id",
          "kind",
          "start_s",
          "end_s"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "WALK"
                }
              }
            },
            "then": {
              "required": [
                "waypoints"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "PICK",
                    "DROPOFF",
                    "PACK",
                    "IDLE"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "pos"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "PICK"
                }
              }
            },
            "then": {
              "required": [
                "sku_id",
                "slot_id",
                "quantity",
                "order_id"
              ]
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "at_s": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "order_arrived",
              "order_assigned",
              "sku_picked",
              "picked_last",
              "pick_finished",
              "pack_started",
              "order_completed"
            ]
          },
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "sku_id": {
            "type": "string",
            "minLength": 1
          },
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "seq",
          "at_s",
          "kind",
          "order_id"
        ],
        "additionalProperties": false
      }
    },
    "orders_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "picker_id": {
            "type": "string",
            "minLength": 1
          },
          "arrival_s": {
            "type": "number",
            "minimum": 0
          },
          "assigned_s": {
            "type": "number",
            "minimum": 0
          },
          "picked_last_s": {
            "type": "number",
            "minimum": 0
          },
          "pick_finished_s": {
            "type": "number",
            "minimum": 0
          },
          "pack_started_s": {
            "type": "number",
            "minimum": 0
          },
          "completed_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "order_id",
          "picker_id",
          "arrival_s",
          "assigned_s",
          "picked_last_s",
          "pick_finished_s",
          "pack_started_s",
          "completed_s"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "picker_busy_s": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "packer_busy_s": {
          "type": "number",
          "minimum": 0
        },
        "makespan_s": {
          "type": "number",
          "minimum": 0
        },
        "mean_cycle_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95_cycle_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_pick_cycle_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_pack_wait_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_pack_queue": {
          "type": "integer",
          "minimum": 0
        },
        "time_weighted_mean_pack_queue": {
          "type": "number",
          "minimum": 0
        },
        "completed_total": {
          "type": "integer",
          "minimum": 0
        },
        "completed_by_horizon": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_at_horizon": {
          "type": "integer",
          "minimum": 0
        },
        "relocation_labor_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "total_distance_m",
        "picker_busy_s",
        "packer_busy_s",
        "makespan_s",
        "mean_cycle_s",
        "p95_cycle_s",
        "mean_pick_cycle_s",
        "mean_pack_wait_s",
        "max_pack_queue",
        "time_weighted_mean_pack_queue",
        "completed_total",
        "completed_by_horizon",
        "backlog_at_horizon",
        "relocation_labor_s"
      ],
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "picker",
              "packer"
            ]
          },
          "initial_pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "actor_id",
          "role",
          "initial_pos"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "layout_version",
    "run_id",
    "data_version",
    "config",
    "initial_assignment",
    "scenario",
    "actions",
    "events",
    "orders_summary",
    "metrics",
    "actors"
  ],
  "additionalProperties": false
}
