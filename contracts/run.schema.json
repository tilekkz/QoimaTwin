{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "layout_version": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_type": {
      "enum": [
        "slotting",
        "staffing",
        "demand_stress",
        "fixture"
      ]
    },
    "input_hashes": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipts": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "initial_inventory": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assignment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "orders",
        "receipts",
        "config",
        "initial_inventory",
        "assignment"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "termination_reason": {
      "enum": [
        "drained",
        "unfulfilled_inventory",
        "max_drain",
        "deadlock",
        "error"
      ]
    },
    "horizon_s": {
      "type": "number",
      "minimum": 0
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "picker",
              "packer",
              "receiver",
              "shipper",
              "forklift_driver"
            ]
          },
          "initial_pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "home_node_id": {
            "type": "string",
            "minLength": 1
          },
          "vehicle_id": {
            "type": "string",
            "minLength": 1
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "actor_id",
          "role",
          "initial_pos"
        ],
        "additionalProperties": false
      },
      "minItems": 24,
      "maxItems": 24
    },
    "cargo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cargo_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "tote",
              "parcel",
              "pallet",
              "lot"
            ]
          },
          "contents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "sku_id",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "order_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "cargo_id",
          "kind",
          "contents",
          "order_ids"
        ],
        "additionalProperties": false
      }
    },
    "initial_state": {
      "type": "object",
      "properties": {
        "inventory_lots": {
          "type": "array"
        },
        "tote_pool": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cells": {
          "type": "object"
        },
        "queues": {
          "type": "object"
        },
        "merge_cursors": {
          "type": "object"
        },
        "station_reserved_wip": {
          "type": "object"
        },
        "pallet_state": {
          "type": "object"
        }
      },
      "required": [
        "inventory_lots",
        "tote_pool",
        "cells",
        "queues",
        "merge_cursors",
        "station_reserved_wip",
        "pallet_state"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "TRAVEL",
              "BUSY_SERVICE",
              "BLOCKED",
              "WAIT_RESOURCE",
              "IDLE"
            ]
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "at_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "node_id",
                "pos",
                "at_s"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "action_id",
          "actor_id",
          "state",
          "operation",
          "start_s",
          "end_s",
          "entity_id"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "at_s": {
            "type": "number",
            "minimum": 0
          },
          "phase": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "order_arrived",
              "order_rejected_inventory",
              "order_assigned",
              "stock_reserved",
              "sku_picked",
              "picked_last",
              "handoff_ready",
              "tote_inducted",
              "cell_entered",
              "cell_exited",
              "pack_started",
              "order_packed",
              "parcel_outfed",
              "shipping_arrived",
              "parcel_scanned",
              "pallet_sealed",
              "order_dispatched",
              "receipt_accepted",
              "receipt_processed",
              "pallet_putaway",
              "stock_transferred",
              "actor_state_changed",
              "pallet_seal_pending"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "seq",
          "at_s",
          "phase",
          "kind",
          "entity_id",
          "payload"
        ],
        "additionalProperties": false
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_s": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "type": "object"
          }
        },
        "required": [
          "at_s",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "arrived_total": {
          "type": "integer",
          "minimum": 0
        },
        "packed_total": {
          "type": "integer",
          "minimum": 0
        },
        "dispatched_total": {
          "type": "integer",
          "minimum": 0
        },
        "unfulfilled_inventory_total": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_at_horizon": {
          "type": "integer",
          "minimum": 0
        },
        "all_orders_makespan_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean_cycle_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95_cycle_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "role_metrics": {
          "type": "object"
        },
        "queue_metrics": {
          "type": "object"
        },
        "conveyor_metrics": {
          "type": "object"
        },
        "inventory_balance": {
          "type": "object"
        }
      },
      "required": [
        "arrived_total",
        "packed_total",
        "dispatched_total",
        "unfulfilled_inventory_total",
        "backlog_at_horizon",
        "all_orders_makespan_s",
        "mean_cycle_s",
        "p95_cycle_s",
        "role_metrics",
        "queue_metrics",
        "conveyor_metrics",
        "inventory_balance"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "layout_version",
    "engine_version",
    "scenario_id",
    "experiment_type",
    "input_hashes",
    "status",
    "termination_reason",
    "horizon_s",
    "actors",
    "cargo",
    "initial_state",
    "actions",
    "events",
    "snapshots",
    "metrics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qoyma.local/schema/run-v2.json"
}
